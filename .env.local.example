# Copier ce fichier en .env.local (jamais committé) et remplir avec les
# valeurs du projet Supabase : Project Settings > API.

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Clé service_role : accès complet, contourne les policies RLS.
# Utilisée uniquement côté serveur (jamais NEXT_PUBLIC_) — pour des
# opérations d'administration futures (ex: promouvoir un coach). Pas encore
# utilisée en phase 1.
SUPABASE_SERVICE_ROLE_KEY=

# Utilisée pour construire les liens de confirmation/reset envoyés par email.
# En local : http://localhost:3000. En prod : l'URL du site déployé.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Jarvis boosté à l'IA (optionnel). Uniquement côté serveur, jamais exposée
# au navigateur. Le coach active/désactive ce mode depuis l'app (bouton ⚡) ;
# tant qu'il n'y a pas de clé ici, le mode reste indisponible même activé.
OPENAI_API_KEY=
OPENAI_MODEL=
OPENAI_PRICE_PER_1M_INPUT=
OPENAI_PRICE_PER_1M_OUTPUT=

# Notifications push (Web Push — gratuit, aucune API tierce). Générer une
# paire avec `npx web-push generate-vapid-keys`. La clé privée reste
# strictement côté serveur.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:
